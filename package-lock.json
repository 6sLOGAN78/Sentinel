{
  "name": "sentinel",
  "version": "1.0.0",
  "lockfileVersion": 2,
  "requires": true,
  "packages": {
    "": {
      "name": "sentinel",
      "version": "1.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {
        "turbo": "^2.9.6",
        "typescript": "^6.0.3"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@turbo/linux-64": {
      "version": "2.9.6",
      "cpu": [
        "x64"
      ],
      "dev": true,
      "license": "MIT",
      "optional": true,
      "os": [
        "linux"
      ]
    },
    "node_modules/turbo": {
      "version": "2.9.6",
      "dev": true,
      "license": "MIT",
      "bin": {
        "turbo": "bin/turbo"
      },
      "optionalDependencies": {
        "@turbo/darwin-64": "2.9.6",
        "@turbo/darwin-arm64": "2.9.6",
        "@turbo/linux-64": "2.9.6",
        "@turbo/linux-arm64": "2.9.6",
        "@turbo/windows-64": "2.9.6",
        "@turbo/windows-arm64": "2.9.6"
      }
    },
    "node_modules/typescript": {
      "version": "6.0.3",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    }
  },
  "dependencies": {
    "@turbo/linux-64": {
      "version": "2.9.6",
      "dev": true,
      "optional": true
    },
    "turbo": {
      "version": "2.9.6",
      "dev": true,
      "requires": {
        "@turbo/darwin-64": "2.9.6",
        "@turbo/darwin-arm64": "2.9.6",
        "@turbo/linux-64": "2.9.6",
        "@turbo/linux-arm64": "2.9.6",
        "@turbo/windows-64": "2.9.6",
        "@turbo/windows-arm64": "2.9.6"
      }
    },
    "typescript": {
      "version": "6.0.3",
      "dev": true
    }
  }
}
