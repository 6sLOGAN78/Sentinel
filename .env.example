# Sentinel local environment template. Placeholders only (D-22).
#
# Usage: `make dev-up` copies this file to .env if .env is absent. Never commit .env.
#
# Dotted keys such as SENTINEL_DATABASE.HOST cannot be exported from bash.
# Use `env 'SENTINEL_PRIMARY.ENV=local' <cmd>` or let godotenv load this file
# (`make run SVC=...` does this for you).
#
# Host ports (chosen to avoid collisions with common defaults 5432/6379/9000/9092):
#   Kafka 29092, PostgreSQL 15432, Redis 16379, ClickHouse HTTP 18123, native 19000.
# All ports bind to 127.0.0.1 only.

# --- Compose inputs (plain names, read by docker compose) ---
SENTINEL_POSTGRES_PASSWORD=change-me-local
SENTINEL_CLICKHOUSE_PASSWORD=change-me-local

# --- Application config (koanf keys) ---
SENTINEL_PRIMARY.ENV=local
# SENTINEL_ENV_FILE=../.env   # set by `make run` to the absolute path of the root .env

SENTINEL_OBSERVABILITY.LOGGING.LEVEL=debug
SENTINEL_OBSERVABILITY.LOGGING.FORMAT=console

SENTINEL_DATABASE.HOST=127.0.0.1
SENTINEL_DATABASE.PORT=15432
SENTINEL_DATABASE.USER=sentinel
SENTINEL_DATABASE.PASSWORD=change-me-local
SENTINEL_DATABASE.NAME=sentinel
# LOCAL ONLY: the Compose Postgres has no TLS. The config default is verify-full;
# disable/allow/prefer are accepted only when SENTINEL_PRIMARY.ENV is local or test.
SENTINEL_DATABASE.SSL_MODE=disable
SENTINEL_DATABASE.MAX_OPEN_CONNS=10
SENTINEL_DATABASE.MAX_IDLE_CONNS=5
SENTINEL_DATABASE.CONN_MAX_LIFETIME=300
SENTINEL_DATABASE.CONN_MAX_IDLE_TIME=60

SENTINEL_REDIS.ADDRESS=127.0.0.1:16379

SENTINEL_KAFKA.BROKERS=127.0.0.1:29092

SENTINEL_CLICKHOUSE.HTTP_ADDRESS=127.0.0.1:18123
SENTINEL_CLICKHOUSE.NATIVE_ADDRESS=127.0.0.1:19000
SENTINEL_CLICKHOUSE.USER=sentinel
SENTINEL_CLICKHOUSE.PASSWORD=change-me-local
SENTINEL_CLICKHOUSE.DATABASE=sentinel

SENTINEL_RATELIMIT.FAIL_MODE=closed

SENTINEL_CONTRACTS.MAX_ATTR_KEYS=32
SENTINEL_CONTRACTS.MAX_ATTR_BYTES=4096
SENTINEL_CONTRACTS.FUTURE_SKEW=5m
SENTINEL_CONTRACTS.PAST_SKEW=168h

# --- Topic overrides (read by the topic-init one-shot) ---
EVENTS_PARTITIONS=6
ALERTS_PARTITIONS=3
EVENTS_RETENTION_MS=86400000
ALERTS_RETENTION_MS=604800000
DLQ_RETENTION_MS=604800000
